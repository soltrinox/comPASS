# comPASS Probe plane — credential & network boundary
# Copy to .env locally. Never commit real keys. Never load these into Route/Graph/hooks/WASM.
#
# Supply secrets via: exported env vars, direnv, or OS keychain (service comPASS.probe).
# See docs/probe/CREDENTIALS.md, docs/probe/ROTATION.md, docs/probe/LIVE-SMOKE.md.

# --- Probe catalog / live-transport credentials (Probe sidecar ONLY) ---
# Leave empty locally until you intentionally enable live Probe. Placeholders only in git.
OPENROUTER_API_KEY=
HF_TOKEN=
# Alternate HF Hub name (also accepted by Probe loaders):
# HUGGING_FACE_HUB_TOKEN=
CURSOR_API_KEY=

# Legacy / unused-by-Probe placeholders (do not put on Route path):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Outbound probe HTTP is OFF by default. Set to 1/true only when intentionally enabling live probes.
COMPASS_PROBE_ALLOW_NETWORK=0

# Optional comma-separated host allowlist override (no wildcards). Defaults include:
# huggingface.co, api-inference.huggingface.co, openrouter.ai, api.openrouter.ai,
# api2.cursor.sh, api.cursor.com
# COMPASS_PROBE_HOST_ALLOWLIST=huggingface.co,openrouter.ai,api2.cursor.sh

# Optional override path to a corpus JSON (defaults to repo fixtures/probe/corpus.json).
# COMPASS_PROBE_CORPUS=

# --- Tier 3 OpenAI-compatible proxy (service process; never hook / WASM path) ---
# Separate from Probe catalog keys. Proxy may hold its own upstream Authorization
# in the service process only — still never in compressor hooks or browser WASM.
# Leave unset for dry-run only (no upstream, no keys required).
# COMPASS_PROXY_UPSTREAM=https://api.openai.com
# COMPASS_PROXY_HOST=127.0.0.1
# COMPASS_PROXY_PORT=8787
# COMPASS_PROXY_UPSTREAM_API_KEY=
